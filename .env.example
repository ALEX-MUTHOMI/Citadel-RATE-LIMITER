# Django
DJANGO_SETTINGS_MODULE=citadel.settings.development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database / cache (Docker Compose)
POSTGRES_DB=citadel
POSTGRES_USER=citadel
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_BACKEND=redis

# API token used by other Citadel projects. Generate locally; never commit the value.
CITADEL_API_TOKEN=
CITADEL_BOOTSTRAP_CLIENT=local-docker

# Docker Hub username is public. The access token lives only in GitHub Actions secrets
# as DOCKERHUB_TOKEN and in your local Docker login — never in this repo.
DOCKERHUB_USERNAME=backtofrontdev
